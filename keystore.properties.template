# انسخ هذا الملف باسم keystore.properties (بنفس مجلد المشروع، جنب settings.gradle)
# واملأ القيم الحقيقية تبع الـ Keystore اللي سويته بأندرويد ستوديو.
# ملف keystore.properties نفسه ما ينرفع لأي Git لأنه محطوط بـ .gitignore.

# المسار الكامل لملف الـ keystore (.jks) اللي سويته، مثال على ويندوز:
# storeFile=C:\\Users\\اسمك\\Documents\\Keystores\\dinari-bourse.jks
# أو على ماك/لينكس:
# storeFile=/Users/اسمك/Keystores/dinari-bourse.jks
storeFile=

# نفس الباسورد اللي حطيته وقت إنشاء الـ Keystore
storePassword=

# نفس الـ Alias اللي اخترته
keyAlias=

# باسورد الـ Alias (عادةً نفس storePassword إذا خليتها نفسها وقت الإنشاء)
keyPassword=
