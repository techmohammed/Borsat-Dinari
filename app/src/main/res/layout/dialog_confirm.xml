<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layoutDirection="ltr"
    android:layout_width="300dp"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog_card"
    android:orientation="vertical">

    <!-- عنوان الرسالة + أيقونة الإجراء (سلة مهملات للحذف، تنزيل للتحديث) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="20dp"
        android:paddingTop="18dp"
        android:paddingBottom="14dp">

        <ImageView
            android:id="@+id/ivDialogIcon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginEnd="8dp"
            tools:src="@drawable/ic_delete" />

        <TextView
            android:id="@+id/tvDialogTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="@font/cairo_bold"
            android:gravity="end"
            android:textColor="@color/textPrimary"
            android:textSize="19sp"
            android:textStyle="bold"
            tools:text="حذف" />

    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#E0E0E0" />

    <TextView
        android:id="@+id/tvDialogMessage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="@font/cairo_regular"
        android:gravity="center"
        android:lineSpacingExtra="4dp"
        android:paddingHorizontal="20dp"
        android:paddingVertical="18dp"
        android:textColor="@color/textPrimary"
        android:textSize="15sp"
        tools:text="هل انت متأكد بالقيام بحذف السجلات للفترة المحددة من 09/09/2026 الى 21/09/2026؟" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#E0E0E0" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="14dp"
        android:paddingVertical="12dp">

        <TextView
            android:id="@+id/tvDialogConfirm"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/bg_dialog_button"
            android:fontFamily="@font/cairo_bold"
            android:gravity="center"
            android:paddingVertical="11dp"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold"
            tools:text="حذف" />

        <TextView
            android:id="@+id/tvDialogCancel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:fontFamily="@font/cairo_semibold"
            android:gravity="center"
            android:paddingVertical="11dp"
            android:text="إلغاء"
            android:textColor="@color/textSecondary"
            android:textSize="15sp" />

    </LinearLayout>

</LinearLayout>
