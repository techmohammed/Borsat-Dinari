<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layoutDirection="ltr"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background">

    <!-- الهيدر: اسم البورصة/المدينة بالوسط، زر الرجوع يسار، زر التقويم يمين -->
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/brandBlue"
        android:elevation="0dp"
        app:contentInsetEnd="0dp"
        app:contentInsetStart="0dp"
        app:contentInsetStartWithNavigation="0dp">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_gravity="left|center_vertical"
            android:layout_marginLeft="6dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="رجوع"
            android:padding="10dp"
            android:src="@drawable/ic_back_arrow"
            app:tint="@color/white" />

        <TextView
            android:id="@+id/tvItemName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:ellipsize="end"
            android:fontFamily="@font/cairo_bold"
            android:maxLines="1"
            android:maxWidth="190dp"
            android:textColor="@color/white"
            android:textSize="22sp"
            android:textStyle="bold"
            tools:text="بغداد" />

        <ImageButton
            android:id="@+id/btnPickRange"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_gravity="right|center_vertical"
            android:layout_marginRight="6dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="اختيار فترة"
            android:padding="10dp"
            android:src="@drawable/ic_calendar_31"
            app:tint="@color/white" />

    </androidx.appcompat.widget.Toolbar>

    <!-- شريط تقدم رفيع يظهر فقط أثناء جلب السجلات من القناة -->
    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/syncProgress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:indeterminate="true"
        android:visibility="invisible"
        app:indicatorColor="@color/accentBlue"
        app:trackColor="@android:color/transparent"
        app:trackThickness="3dp" />

    <!-- أزرار الفترة: يوم / أسبوع / شهر / شهرين (يوم بأقصى اليمين) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:layout_marginHorizontal="14dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_tabs_container"
        android:orientation="horizontal"
        android:padding="4dp"
        android:weightSum="4">

        <TextView
            android:id="@+id/tab60"
            style="@style/HistoryTab"
            android:text="شهرين" />

        <TextView
            android:id="@+id/tab30"
            style="@style/HistoryTab"
            android:text="شهر" />

        <TextView
            android:id="@+id/tab7"
            style="@style/HistoryTab"
            android:text="أسبوع" />

        <TextView
            android:id="@+id/tabDay"
            style="@style/HistoryTab"
            android:text="يوم" />

    </LinearLayout>

    <FrameLayout
        android:id="@+id/chartContainer"
        android:layout_width="match_parent"
        android:layout_height="250dp"
        android:layout_marginTop="10dp">

        <com.mohammed.currencyapp.HistoryChartView
            android:id="@+id/historyChart"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

    </FrameLayout>

    <TextView
        android:id="@+id/tvEmpty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="60dp"
        android:fontFamily="@font/cairo_regular"
        android:gravity="center"
        android:text="لا توجد بيانات"
        android:textColor="@color/textSecondary"
        android:textSize="14sp"
        android:visibility="gone" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerHistory"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="6dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="12dp" />

</LinearLayout>
