<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:orientation="vertical">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@color/headerBlue"
        android:layoutDirection="ltr"
        android:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar"
        app:contentInsetEnd="0dp"
        app:contentInsetStart="0dp"
        app:contentInsetLeft="0dp"
        app:contentInsetRight="0dp"
        app:contentInsetStartWithNavigation="0dp">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <ImageView
                android:id="@+id/ivHeaderLogo"
                android:background="?attr/selectableItemBackground"
                android:contentDescription="@string/cd_back"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_gravity="left"
                android:adjustViewBounds="true"
                android:scaleType="fitStart"
                android:src="@drawable/header_bg_image" />





            <TextView
                android:id="@+id/toolbarTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="right|center_vertical"
                android:layout_marginRight="16dp"
                android:text="@string/calculator_title"
                android:textColor="@android:color/white"
                android:textSize="22sp"
                android:fontFamily="@font/cairo_bold" />
        </FrameLayout>
    </androidx.appcompat.widget.Toolbar>

    <ScrollView
        android:scrollbars="none"
        android:overScrollMode="never"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="18dp">

            <LinearLayout
                android:id="@+id/amountInputCard"
                android:layout_width="match_parent"
                android:layout_height="70dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_calculator_input"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="16dp">

                <EditText
                    android:id="@+id/amountInput"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@android:color/transparent"
                    android:clickable="false"
                    android:cursorVisible="false"
                    android:focusable="false"
                    android:fontFamily="@font/cairo_bold"
                    android:gravity="center"
                    android:hint="0"
                    android:inputType="none"
                    android:padding="4dp"
                    android:textColor="@color/rowPriceText"
                    android:textColorHint="@color/textSecondary"
                    android:textSize="30sp" />
            </LinearLayout>

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="146dp"
                android:layout_marginTop="8dp">

                <LinearLayout
                    android:id="@+id/sourceSelector"
                    android:layout_width="match_parent"
                    android:layout_height="70dp"
                    android:layout_gravity="top"
                    android:background="@drawable/bg_calculator_input"
                    android:layoutDirection="rtl"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="14dp">

                    <ImageView
                        android:id="@+id/sourceFlag"
                        android:layout_width="38dp"
                        android:layout_height="48dp"
                        android:contentDescription="@string/calculator_exchange_label"
                        android:src="@drawable/flag_us" />

                    <TextView
                        android:id="@+id/sourceName"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginHorizontal="12dp"
                        android:fontFamily="@font/cairo_semibold"
                        android:textColor="@color/textPrimary"
                        android:gravity="right|center_vertical"
                        android:textSize="19sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/exchangeSelector"
                    android:layout_width="match_parent"
                    android:layout_height="70dp"
                    android:layout_gravity="bottom"
                    android:background="@drawable/bg_calculator_input"
                    android:layoutDirection="rtl"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="14dp">

                    <ImageView
                        android:id="@+id/exchangeFlag"
                        android:layout_width="38dp"
                        android:layout_height="48dp"
                        android:contentDescription="@string/calculator_exchange_label"
                        android:src="@drawable/flag_iq" />

                    <TextView
                        android:id="@+id/exchangeName"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginHorizontal="12dp"
                        android:fontFamily="@font/cairo_semibold"
                        android:textColor="@color/textPrimary"
                        android:gravity="right|center_vertical"
                        android:textSize="19sp" />
                </LinearLayout>

                <ImageButton
                    android:id="@+id/swapButton"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_gravity="top|center_horizontal"
                    android:layout_marginTop="51dp"
                    android:translationX="-120dp"
                    android:background="@drawable/bg_calculator_swap"
                    android:contentDescription="@string/calculator_swap"
                    android:elevation="8dp"
                    android:padding="10dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_swap_vertical_white" />
            </FrameLayout>

            <LinearLayout
                android:id="@+id/resultNumberPanel"
                android:layout_width="match_parent"
                android:layout_height="70dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_calculator_result"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="8dp">

                <TextView
                    android:id="@+id/resultNumber"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/cairo_bold"
                    android:gravity="center"
                    android:text="—"
                    android:textColor="@color/calculatorResultText"
                    android:textSize="34sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/resultUnitPanel"
                android:layout_width="match_parent"
                android:layout_height="70dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_calculator_result"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="8dp">
                <TextView
                    android:id="@+id/resultUnit"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:gravity="center"
                    android:textColor="@color/calculatorResultText"
                    android:textSize="22sp" />
            </LinearLayout>

            <GridLayout
                android:id="@+id/numberPad"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:columnCount="3"
                android:rowCount="4"
                android:layoutDirection="rtl"
                android:alignmentMode="alignMargins"
                android:useDefaultMargins="true">

                <Button android:id="@+id/key9" android:text="9" style="@style/CalculatorKeyStyle" />
                <Button android:id="@+id/key8" android:text="8" style="@style/CalculatorKeyStyle" />
                <Button android:id="@+id/key7" android:text="7" style="@style/CalculatorKeyStyle" />
                <Button android:id="@+id/key6" android:text="6" style="@style/CalculatorKeyStyle" />
                <Button android:id="@+id/key5" android:text="5" style="@style/CalculatorKeyStyle" />
                <Button android:id="@+id/key4" android:text="4" style="@style/CalculatorKeyStyle" />
                <Button android:id="@+id/key3" android:text="3" style="@style/CalculatorKeyStyle" />
                <Button android:id="@+id/key2" android:text="2" style="@style/CalculatorKeyStyle" />
                <Button android:id="@+id/key1" android:text="1" style="@style/CalculatorKeyStyle" />
                <Button android:id="@+id/keyDelete" android:text="⌫" android:contentDescription="مسح مرتبة" style="@style/CalculatorDeleteKeyStyle" />
                <Button android:id="@+id/key0" android:text="0" style="@style/CalculatorKeyStyle" />
                <Button android:id="@+id/keyPoint" android:text="." style="@style/CalculatorKeyStyle" />
            </GridLayout>

        </LinearLayout>
    </ScrollView>
</LinearLayout>
