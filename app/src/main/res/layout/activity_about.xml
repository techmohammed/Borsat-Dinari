<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layoutDirection="ltr"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@color/headerBlue"
        android:elevation="0dp"
        android:theme="@style/ThemeOverlay.MaterialComponents.Dark.ActionBar"
        app:contentInsetEnd="0dp"
        app:contentInsetStart="0dp"
        app:contentInsetLeft="0dp"
        app:contentInsetRight="0dp"
        app:contentInsetStartWithNavigation="0dp">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <ImageView
                android:id="@+id/ivHeaderLogo"
                android:background="?attr/selectableItemBackground"
                android:contentDescription="@string/cd_back"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_gravity="left"
                android:adjustViewBounds="true"
                android:scaleType="fitStart"
                android:src="@drawable/header_bg_image" />





            <TextView
                android:id="@+id/toolbarTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="right|center_vertical"
                android:layout_marginRight="16dp"
                android:fontFamily="@font/cairo_bold"
                android:text="@string/settings_about"
                android:textColor="@android:color/white"
                android:textSize="22sp" />
        </FrameLayout>
    </androidx.appcompat.widget.Toolbar>

    <ScrollView
        android:scrollbars="none"
        android:overScrollMode="never"
        android:id="@+id/scrollAbout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="24dp"
            android:paddingVertical="28dp">

            <!-- الأيقونة -->
            <ImageView
                android:layout_width="128dp"
                android:layout_height="128dp"
                android:layout_gravity="center_horizontal"
                android:contentDescription="@string/cd_app_icon"
                android:src="@mipmap/ic_launcher" />

            <!-- اسم التطبيق -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="16dp"
                android:fontFamily="@font/cairo_bold"
                android:text="@string/app_name"
                android:textColor="@color/textPrimary"
                android:textSize="30sp" />

            <!-- الوصف -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:fontFamily="@font/cairo_regular"
                android:gravity="center"
                android:lineSpacingExtra="6dp"
                android:text="@string/about_description"
                android:textColor="@color/textSecondary"
                android:textSize="15sp" />

            <!-- خط فاصل -->
            <View
                android:layout_width="60dp"
                android:layout_height="2dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="24dp"
                android:background="#1F000000" />

            <!-- مميزات التطبيق -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:gravity="center"
                android:fontFamily="@font/cairo_bold"
                android:text="@string/about_features_title"
                android:textColor="@color/textPrimary"
                android:textSize="18sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    style="@style/AboutFeatureLine"
                    android:text="@string/about_feature_free" />

                <TextView
                    style="@style/AboutFeatureLine"
                    android:layout_marginTop="10dp"
                    android:text="@string/about_feature_ads" />

                <TextView
                    style="@style/AboutFeatureLine"
                    android:layout_marginTop="10dp"
                    android:text="@string/about_feature_nonprofit" />

                <TextView
                    style="@style/AboutFeatureLine"
                    android:layout_marginTop="10dp"
                    android:text="@string/about_feature_permissions" />

                <TextView
                    style="@style/AboutFeatureLine"
                    android:layout_marginTop="10dp"
                    android:text="@string/about_feature_notifications" />

                <TextView
                    style="@style/AboutFeatureLine"
                    android:layout_marginTop="10dp"
                    android:text="@string/about_feature_lightweight" />

                <TextView
                    style="@style/AboutFeatureLine"
                    android:layout_marginTop="10dp"
                    android:text="@string/about_feature_privacy" />

                <TextView
                    style="@style/AboutFeatureLine"
                    android:layout_marginTop="10dp"
                    android:text="@string/about_feature_history" />

                <TextView
                    style="@style/AboutFeatureLine"
                    android:layout_marginTop="10dp"
                    android:text="@string/about_feature_opensource" />

            </LinearLayout>

            <!-- معلومات التطبيق -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:gravity="center"
                android:fontFamily="@font/cairo_bold"
                android:text="@string/about_info_title"
                android:textColor="@color/textPrimary"
                android:textSize="18sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- سطر النسخة + رسالة التحديث بجانبه (حمراء): "يوجد تحديث جديد"
                     (تنضغط وتفتح منشور القناة) أو "لديك اخر اصدار". تبقى مخفية
                     لو ماكو نت أو فشل الفحص. -->
                <LinearLayout
                    android:id="@+id/aboutVersionRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvVersion"
                        style="@style/AboutInfoLine"
                        android:layout_width="wrap_content"
                        android:text="@string/about_version_format" />

                    <TextView
                        android:id="@+id/tvUpdateStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:fontFamily="@font/cairo_semibold"
                        android:textColor="#D32F2F"
                        android:textSize="13sp"
                        android:visibility="gone" />

                </LinearLayout>

                <TextView
                    style="@style/AboutInfoLine"
                    android:layout_marginTop="10dp"
                    android:text="@string/about_designer" />

                <TextView
                    style="@style/AboutInfoLine"
                    android:layout_marginTop="10dp"
                    android:text="@string/about_year" />

                <TextView
                    style="@style/AboutInfoLine"
                    android:layout_marginTop="10dp"
                    android:text="@string/about_last_update" />

            </LinearLayout>

            <!-- آخر التحديثات بهذه النسخة -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:fontFamily="@font/cairo_bold"
                android:gravity="center"
                android:text="@string/about_updates_title"
                android:textColor="@color/textPrimary"
                android:textSize="18sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    style="@style/AboutFeatureLine"
                    android:lineSpacingExtra="6dp"
                    android:text="@string/about_updates_text" />
            </LinearLayout>

            <!-- الاقتباس: خلفية باهتة (صورة بغداد بدرجة أزرق فاتح جداً) خلف النص -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:layout_marginBottom="12dp"
                android:background="@drawable/bg_card"
                android:clipToOutline="true">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:alpha="@dimen/quote_bg_alpha"
                    android:contentDescription="@null"
                    android:scaleType="centerCrop"
                    android:src="@drawable/about_quote_bg" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/cairo_regular"
                        android:gravity="center"
                        android:lineSpacingExtra="8dp"
                        android:text="@string/about_quote"
                        android:textColor="@color/textSecondary"
                        android:textSize="14sp"
                        android:textStyle="italic" />

                </LinearLayout>
            </FrameLayout>

        </LinearLayout>

    </ScrollView>

</LinearLayout>
