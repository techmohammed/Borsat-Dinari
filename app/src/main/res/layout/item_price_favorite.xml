<?xml version="1.0" encoding="utf-8"?>
<!-- بطاقة المفضل الأول: الشارة تتداخل مع الحد العلوي، والسعر يبقى يساراً بجانب النجمة. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rowCard"
    android:layoutDirection="ltr"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="120dp"
    android:layout_marginHorizontal="10dp"
    android:layout_marginTop="0dp"
    android:layout_marginBottom="0dp"
    android:background="@drawable/bg_row_card_fav_host"
    android:elevation="6dp">

    <ImageButton
        android:id="@+id/btnStar"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_gravity="left|top"
        android:layout_marginLeft="18dp"
        android:layout_marginTop="58dp"
        android:background="@android:color/transparent"
        android:contentDescription="@string/cd_favorite"
        android:padding="4dp"
        android:src="@drawable/ic_star_filled" />

    <TextView
        android:id="@+id/tvName"
        android:layout_width="210dp"
        android:layout_height="40dp"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="10dp"
        android:gravity="center"
        android:ellipsize="end"
        android:fontFamily="@font/cairo_bold"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:maxWidth="210dp"
        android:paddingHorizontal="8dp"
        android:paddingTop="0dp"
        android:paddingBottom="8dp"
        android:background="@drawable/bg_fav_badge"
        android:textColor="@color/white"
        android:textSize="22sp"
        android:textStyle="bold"
        tools:text="السليمانية" />

    <TextView
        android:id="@+id/tvPrice"
        android:layout_width="250dp"
        android:layout_height="wrap_content"
        android:layout_gravity="left|top"
        android:layout_marginLeft="70dp"
        android:layout_marginTop="50dp"
        android:fontFamily="@font/cairo_bold"
        android:gravity="left|center_vertical"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:textColor="@color/rowPriceText"
        android:textSize="34sp"
        android:textStyle="bold"
        app:autoSizeMaxTextSize="34sp"
        app:autoSizeMinTextSize="16sp"
        app:autoSizeStepGranularity="1sp"
        app:autoSizeTextType="uniform"
        tools:text="166,350" />

    <LinearLayout
        android:id="@+id/deltaRow"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="left|top"
        android:layout_marginLeft="76dp"
        android:layout_marginTop="94dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/ivDeltaArrow"
            android:layout_width="15dp"
            android:layout_height="15dp"
            android:contentDescription="@null"
            tools:src="@drawable/ic_tri_up" />

        <TextView
            android:id="@+id/tvDelta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="5dp"
            android:fontFamily="@font/cairo_bold"
            android:includeFontPadding="false"
            android:textSize="17sp"
            android:textStyle="bold"
            tools:text="+500"
            tools:textColor="@color/deltaUp" />
    </LinearLayout>

    <ImageView
        android:id="@+id/ivFlag"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_gravity="right|top"
        android:layout_marginTop="49dp"
        android:layout_marginRight="12dp"
        android:background="@drawable/bg_flag_ring"
        android:contentDescription="@null"
        android:padding="1dp"
        android:scaleType="centerCrop"
        tools:src="@drawable/flag_iq" />

    <TextView
        android:id="@+id/tvUnit"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="right|top"
        android:layout_marginTop="80dp"
        android:layout_marginRight="78dp"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:textColor="@color/textSecondary"
        android:fontFamily="@font/cairo_bold"
        android:textSize="13sp"
        android:textStyle="bold"
        tools:text="100$" />

    <TextView
        android:id="@+id/tvUpdateTime"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="right|top"
        android:layout_marginTop="101dp"
        android:layout_marginRight="72dp"
        android:fontFamily="@font/cairo_regular"
        android:includeFontPadding="false"
        android:gravity="right"
        android:maxLines="1"
        android:textColor="@color/textSecondary"
        android:textSize="9sp"
        tools:text="18:45 - 13/10/2026" />

</FrameLayout>
