<?xml version="1.0" encoding="utf-8"?>
<!-- صف المدينة المفضلة: أكبر وأبرز من باقي الصفوف (ارتفاع، سعر، علم، إطار أزرق، ظل،
     واسم المدينة بشارة زرقاء). نفس معرّفات item_price حتى يستخدم نفس RowViewHolder. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rowCard"
    android:layoutDirection="ltr"
    android:layout_width="match_parent"
    android:layout_height="108dp"
    android:layout_marginHorizontal="10dp"
    android:layout_marginTop="8dp"
    android:layout_marginBottom="10dp"
    android:background="@drawable/bg_row_card_fav"
    android:elevation="6dp"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="10dp">

    <ImageButton
        android:id="@+id/btnStar"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@android:color/transparent"
        android:contentDescription="مفضلة"
        android:padding="4dp"
        android:src="@drawable/ic_star_filled" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="4dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvPrice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/cairo_bold"
            android:gravity="left|center_vertical"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textColor="@color/rowPriceText"
            android:textSize="34sp"
            android:textStyle="bold"
            app:autoSizeMaxTextSize="34sp"
            app:autoSizeMinTextSize="16sp"
            app:autoSizeStepGranularity="1sp"
            app:autoSizeTextType="uniform"
            tools:text="156,400" />

        <LinearLayout
            android:id="@+id/deltaRow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/ivDeltaArrow"
                android:layout_width="15dp"
                android:layout_height="15dp"
                android:contentDescription="@null"
                tools:src="@drawable/ic_tri_up" />

            <TextView
                android:id="@+id/tvDelta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="5dp"
                android:fontFamily="@font/cairo_bold"
                android:includeFontPadding="false"
                android:textSize="18sp"
                android:textStyle="bold"
                tools:text="+500"
                tools:textColor="@color/deltaUp" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="10dp"
        android:gravity="right"
        android:orientation="vertical">

        <!-- اسم المدينة داخل شارة زرقاء بنص أبيض -->
        <TextView
            android:id="@+id/tvName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_fav_badge"
            android:ellipsize="end"
            android:fontFamily="@font/cairo_bold"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:maxWidth="160dp"
            android:paddingHorizontal="16dp"
            android:paddingVertical="6dp"
            android:textColor="@color/white"
            android:textSize="24sp"
            android:textStyle="bold"
            tools:text="بغداد" />

        <TextView
            android:id="@+id/tvUnit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="@font/cairo_regular"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textColor="@color/textSecondary"
            android:textSize="13sp"
            tools:text="100$" />
    </LinearLayout>

    <ImageView
        android:id="@+id/ivFlag"
        android:layout_width="62dp"
        android:layout_height="62dp"
        android:background="@drawable/bg_flag_ring"
        android:contentDescription="@null"
        android:padding="1dp"
        android:scaleType="centerCrop"
        tools:src="@drawable/flag_iq" />

</LinearLayout>
