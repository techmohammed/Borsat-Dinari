<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rowCard"
    android:layoutDirection="ltr"
    android:layout_width="match_parent"
    android:layout_height="68dp"
    android:layout_marginHorizontal="12dp"
    android:layout_marginVertical="4dp"
    android:background="@drawable/bg_row_card"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="8dp">

    <!-- نجمة المفضلة -->
    <ImageButton
        android:id="@+id/btnStar"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:background="@android:color/transparent"
        android:contentDescription="مفضلة"
        android:padding="2dp"
        android:src="@drawable/ic_star_outline"
        tools:visibility="visible" />

    <!-- السعر (أسود) وتحته مقدار التغيير مع المثلث -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="4dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvPrice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/cairo_bold"
            android:gravity="left|center_vertical"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textColor="@color/rowPriceText"
            android:textSize="20sp"
            android:textStyle="bold"
            app:autoSizeMaxTextSize="20sp"
            app:autoSizeMinTextSize="12sp"
            app:autoSizeStepGranularity="1sp"
            app:autoSizeTextType="uniform"
            tools:text="156,400 د.ع" />

        <LinearLayout
            android:id="@+id/deltaRow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/ivDeltaArrow"
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:contentDescription="@null"
                tools:src="@drawable/ic_tri_up" />

            <TextView
                android:id="@+id/tvDelta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="4dp"
                android:fontFamily="@font/cairo_bold"
                android:includeFontPadding="false"
                android:textSize="15sp"
                android:textStyle="bold"
                tools:text="+500"
                tools:textColor="@color/deltaUp" />
        </LinearLayout>
    </LinearLayout>

    <!-- اسم المدينة/العملة وتحته الوحدة (100$) -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="8dp"
        android:gravity="right"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="@font/cairo_bold"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:maxWidth="130dp"
            android:textColor="@color/textPrimary"
            android:textSize="18sp"
            android:textStyle="bold"
            tools:text="بغداد" />

        <TextView
            android:id="@+id/tvUnit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:fontFamily="@font/cairo_regular"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textColor="@color/textSecondary"
            android:textSize="12sp"
            tools:text="100$" />
    </LinearLayout>

    <!-- علم صغير بدائرة -->
    <ImageView
        android:id="@+id/ivFlag"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@drawable/bg_flag_ring"
        android:contentDescription="@null"
        android:padding="1dp"
        android:scaleType="centerCrop"
        tools:src="@drawable/flag_iq" />

</LinearLayout>
