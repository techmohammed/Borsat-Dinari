<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layoutDirection="ltr"
    android:layout_width="match_parent"
    android:layout_height="76dp"
    android:layout_marginHorizontal="4dp"
    android:layout_marginVertical="2dp"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:background="@android:color/transparent"
    android:elevation="0dp">

    <!-- الخلفية تبقى خلف كل المحتوى؛ العلم في الجهة اليمنى فقط بصرياً. -->
    <ImageView
        android:id="@+id/ivFlagBg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="fitXY"
        tools:src="@drawable/row_bg_iq" />

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingLeft="3dp"
        android:paddingRight="3dp">

        <!-- مساحة محجوزة للعلم حتى لا تدخل الأسماء فوقه. لازم تكون داخل
             نفس الـ RelativeLayout اللي يشير إليها tvName (قاعدة أساسية
             بالـ RelativeLayout: العنصر المُشار إليه لازم يكون شقيق ضمن
             نفس الحاوية، وإلا Lint يعتبره خطأ NotSibling ويفشل بناء release). -->
        <View
            android:id="@+id/flagZone"
            android:layout_width="78dp"
            android:layout_height="match_parent"
            android:layout_alignParentRight="true"
            android:visibility="invisible" />

        <ImageButton
            android:id="@+id/btnStar"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_alignParentLeft="true"
            android:layout_centerVertical="true"
            android:layout_marginLeft="6dp"
            android:background="@android:color/transparent"
            android:contentDescription="مفضلة"
            android:padding="1dp"
            android:src="@drawable/ic_star_outline"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/tvPrice"
            android:layout_width="wrap_content"
            android:layout_height="30dp"
            android:layout_centerVertical="true"
            android:layout_marginLeft="0dp"
            android:layout_toRightOf="@id/btnStar"
            android:background="@drawable/bg_badge"
            android:gravity="center"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:minWidth="104dp"
            android:paddingHorizontal="7dp"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold"
            android:fontFamily="@font/cairo_bold"
            tools:text="155,450 د.ع" />

        <TextView
            android:id="@+id/tvUnit"
            android:layout_width="66dp"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginLeft="0dp"
            android:layout_toRightOf="@id/tvPrice"
            android:gravity="center"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textColor="@color/rowTextOnFlag"
            android:textSize="16sp"
            android:textStyle="bold"
            android:fontFamily="@font/cairo_bold"
            tools:text="100$" />

        <TextView
            android:id="@+id/tvName"
            android:layout_width="108dp"
            android:layout_height="34dp"
            android:layout_centerVertical="true"
            android:layout_marginLeft="-23dp"
            android:layout_toRightOf="@id/tvUnit"
            android:layout_toLeftOf="@id/flagZone"
            android:gravity="center"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:ellipsize="end"
            android:textColor="@color/rowTextOnFlag"
            android:textSize="16sp"
            android:textStyle="bold"
            android:fontFamily="@font/cairo_bold"
            tools:text="بغداد" />

    </RelativeLayout>

    <!-- ظل داخلي رفيع حول حافة الصف — يظهر بالوضع الليلي فقط تلقائياً
         (انظر drawable-night/row_inner_shadow.xml)، وشفاف بالكامل بالوضع
         النهاري. آخر عنصر بالـ FrameLayout حتى يرسم فوق كل المحتوى ويأطر
         الصف بالكامل من الداخل. -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/row_inner_shadow" />

</FrameLayout>
