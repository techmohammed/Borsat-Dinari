<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="CalculatorKeyStyle" parent="Widget.AppCompat.Button">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">70dp</item>
        <item name="android:layout_columnWeight">1</item>
        <item name="android:background">@drawable/bg_calculator_key</item>
        <item name="android:fontFamily">@font/cairo_bold</item>
        <item name="android:textColor">@color/calculator_key_text</item>
        <item name="android:textSize">24sp</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:padding">0dp</item>
        <item name="android:textAllCaps">false</item>
    </style>
    <style name="CalculatorDeleteKeyStyle" parent="CalculatorKeyStyle">
        <item name="android:textColor">@color/calculatorDeleteText</item>
    </style>
</resources>
